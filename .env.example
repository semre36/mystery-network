# ==============================================================================
# MYSTERY NETWORK — Environment Configuration Template
# Copy this file to .env.local / .env for local development. Never commit .env files.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000

# Public Application Metadata
NEXT_PUBLIC_APP_NAME="MYSTERY NETWORK"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Database Configuration (Neon PostgreSQL — Phase 02)
# ------------------------------------------------------------------------------
# DATABASE_URL: Neon Pooled Connection string (PgBouncer, port 6543 / -pooler host)
# Used by Next.js application runtime for high-concurrency connection pooling.
# NOTE: connect_timeout=30 allows Neon serverless compute to wake up from cold standby.
DATABASE_URL="postgresql://[user]:[password]@[neon-host]-pooler.neon.tech/neondb?sslmode=require&connect_timeout=30"

# DIRECT_URL: Neon Direct Connection string (Port 5432, unpooled)
# Used exclusively by Prisma CLI for DDL migrations and schema changes.
DIRECT_URL="postgresql://[user]:[password]@[neon-host].neon.tech/neondb?sslmode=require&connect_timeout=30"

# ------------------------------------------------------------------------------
# Telegram Bot Configuration (Phase 03)
# ------------------------------------------------------------------------------
# Secret bot token provided by @BotFather. Keep strictly server-side.
TELEGRAM_BOT_TOKEN=""

# Official bot username without @
TELEGRAM_BOT_USERNAME="mysterynetworkbot"

# High-entropy random secret (1-256 chars) sent in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=""

# Public HTTPS URL of the application webhook endpoint (e.g. https://your-domain.com/api/telegram/webhook)
TELEGRAM_WEBHOOK_URL=""

# Telegram Mini App URL (optional in Phase 03; will launch web app via inline buttons when set)
NEXT_PUBLIC_TELEGRAM_MINI_APP_URL=""

# ------------------------------------------------------------------------------
# Future Phase Configuration Placeholders
# NOTE: Do NOT configure or populate these in Phase 03.
# ------------------------------------------------------------------------------

# Telegram WebApp Cryptographic Validation Secret (Phase 04)
# TELEGRAM_WEBAPP_SECRET=""
