{
  "name": "mystery-network",
  "version": "0.1.0",
  "private": true,
  "description": "Global collaborative detective investigation platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "telegram:info": "tsx scripts/telegram-setup.ts info",
    "telegram:set-commands": "tsx scripts/telegram-setup.ts set-commands",
    "telegram:set-webhook": "tsx scripts/telegram-setup.ts set-webhook",
    "telegram:delete-webhook": "tsx scripts/telegram-setup.ts delete-webhook"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tma.js/init-data-node": "^2.0.8",
    "clsx": "^2.1.1",
    "grammy": "^1.46.0",
    "lucide-react": "^1.69.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
